generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum FulfilmentType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  READY_FOR_PICKUP
  SERVED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PENDING_PAYMENT
  REQUIRES_ACTION
  PAID
  FAILED
  REFUNDED
  PAY_IN_STORE
}

enum OrderType {
  DINE_IN
  COLLECTION
  DELIVERY
}

enum PaymentMethod {
  STRIPE_ONLINE
  PAY_IN_STORE
  CASH_ON_COLLECTION
  CASH_ON_DELIVERY
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  SEATED
  COMPLETED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  STAFF
  KITCHEN
}

enum WebsiteEventType {
  page_view
  menu_view
  add_to_cart
  checkout_start
  booking_form_view
  booking_submit
  order_complete
}

enum AdminActivityType {
  admin_login
  staff_invited
  staff_updated
  staff_disabled
  order_created
  order_item_added
  order_item_removed
  order_amended
  order_sent_to_kitchen
  order_cancelled
  order_marked_paid
  table_cleared
  order_status_update
  booking_status_update
  menu_update
  review_moderation
  settings_update
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String?
  name            String
  phone           String?
  role            Role             @default(CUSTOMER)
  customerProfile CustomerProfile?
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  loyaltyPoints   LoyaltyPoint[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CustomerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingOptIn Boolean @default(false)
  referralCode String   @unique
  referredBy   String?
  createdAt    DateTime @default(now())
}

model Address {
  id           String  @id @default(cuid())
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  label        String?
  line1        String
  line2        String?
  city         String
  postcode     String
  phone        String?
  deliveryNote String?
  isDefault    Boolean @default(false)
  orders       Order[]
}

model MenuCategory {
  id          String     @id
  name        String
  slug        String     @unique
  description String
  sortOrder   Int        @default(0)
  hidden      Boolean    @default(false)
  items       MenuItem[]
}

model MenuItem {
  id           String           @id
  categoryId   String
  category     MenuCategory     @relation(fields: [categoryId], references: [id])
  name         String
  slug         String           @unique
  description  String
  pricePence   Int
  image        String
  allergens    String[]
  spiceLevel   Int              @default(0)
  halal        Boolean          @default(true)
  available    Boolean          @default(true)
  published    Boolean          @default(false)
  hidden       Boolean          @default(false)
  popular      Boolean          @default(false)
  recommended  Boolean          @default(false)
  prepMinutes  Int              @default(15)
  sortOrder    Int              @default(0)
  options      MenuItemOption[]
  addOns       AddOn[]
  orderItems   OrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model MenuItemOption {
  id              String   @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name            String
  priceDeltaPence Int      @default(0)
}

model AddOn {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  pricePence Int
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  lines     Json
  updatedAt DateTime @updatedAt
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  trackingCode      String?         @unique
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderType         OrderType       @default(COLLECTION)
  tableId           String?
  tableNumber       String?
  customerName      String
  customerEmail     String?
  customerPhone     String?
  email             String
  phone             String
  fulfilmentType    FulfilmentType
  addressId         String?
  address           Address?        @relation(fields: [addressId], references: [id])
  deliveryNotes     String?
  deliveryAddress   Json?
  scheduledFor      DateTime?
  status            OrderStatus     @default(RECEIVED)
  paymentMethod     PaymentMethod   @default(STRIPE_ONLINE)
  paymentStatus     PaymentStatus   @default(PENDING)
  subtotalPence     Int
  discountPence     Int             @default(0)
  deliveryFeePence  Int             @default(0)
  vatPence          Int             @default(0)
  totalPence        Int
  promoCode         String?
  notes             String?
  stripePaymentIntentId String?
  items             OrderItem[]
  payment           Payment?
  review            Review?
  loyaltyPoints     LoyaltyPoint[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderType])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name           String
  unitPricePence Int
  quantity       Int
  optionIds      String[]
  optionLabels   String[] @default([])
  addOnIds       String[]
  notes          String?
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String        @default("stripe")
  providerPaymentId     String?
  status                PaymentStatus @default(PENDING)
  amountPence           Int
  rawPayload            Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Review {
  id          String       @id @default(cuid())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId     String?      @unique
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating      Int
  name        String
  comment     String
  dishTags    String[]
  status      ReviewStatus @default(PENDING)
  adminReply  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GoogleReviewCache {
  id             String   @id @default(cuid())
  placeId        String
  authorName     String
  rating         Int
  text           String
  profilePhotoUrl String?
  relativeTime   String?
  reviewTime     DateTime?
  cachedAt       DateTime @default(now())
}

model PromoCode {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String
  percentOff     Int?
  amountOffPence Int?
  firstOrderOnly Boolean  @default(false)
  minSpendPence  Int      @default(0)
  active         Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
}

model LoyaltyPoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

model Table {
  id        String    @id @default(cuid())
  name      String
  capacity  Int
  active    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("restaurant_tables")
}

model Booking {
  id             String        @id @default(cuid())
  tableId        String?
  table          Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerName   String
  email          String?
  phone          String
  partySize      Int
  bookingDate    DateTime
  startTime      String
  endTime        String
  notes          String?
  adminNotes     String?
  status         BookingStatus @default(PENDING)
  requiresApproval Boolean     @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookingDate, startTime])
  @@index([status])
}

model BookingAvailability {
  id            String  @id @default(cuid())
  dayOfWeek     Int
  open          Boolean @default(true)
  startTime     String
  endTime       String
  slotDurationMinutes Int @default(60)
  bufferMinutes Int     @default(0)
  maxPartySize  Int     @default(8)
  requiresApproval Boolean @default(true)

  @@unique([dayOfWeek])
}

model BlockedDate {
  id     String   @id @default(cuid())
  date   DateTime @unique
  reason String?
}

model BlockedTimeSlot {
  id        String   @id @default(cuid())
  date      DateTime?
  dayOfWeek Int?
  startTime String
  endTime   String
  reason    String?

  @@index([date])
  @@index([dayOfWeek])
}

model SpecialOpeningHours {
  id            String   @id @default(cuid())
  date          DateTime @unique
  open          Boolean  @default(true)
  startTime     String?
  endTime       String?
  slotDurationMinutes Int?
  bufferMinutes Int?
  maxPartySize  Int?
  requiresApproval Boolean?
  note          String?
}

model OpeningHours {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique
  openTime  String
  closeTime String
  closed    Boolean @default(false)
}

model DeliveryZone {
  id              String  @id @default(cuid())
  name            String
  postcodePrefix  String
  radiusMiles     Float
  deliveryFeePence Int
  minimumOrderPence Int
  active          Boolean @default(true)
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  fullName     String?
  email        String?   @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  inviteAcceptedAt DateTime?
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WebsiteEvent {
  id        String           @id @default(cuid())
  type      WebsiteEventType
  path      String
  sessionId String?
  userId    String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
}

model AdminActivityLog {
  id        String            @id @default(cuid())
  type      AdminActivityType
  message   String
  adminId   String?
  username  String?
  role      String?
  entityId  String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([type])
  @@index([adminId])
  @@index([createdAt])
}

model AppSettings {
  id                    String  @id @default("global")
  restaurantName         String  @default("Saba Cafe")
  restaurantPhone        String?
  restaurantAddress      String?
  businessName           String  @default("Saba Cafe")
  copyrightText          String?
  address                String?
  email                  String?
  phone                  String?
  openingHoursText       String?
  cookieBannerText       String?
  socialLinks            Json?
  googleReviewUrl        String?
  googlePlaceId          String?
  googleMapsEmbedUrl     String?
  deliveryPaused         Boolean @default(false)
  pickupPaused           Boolean @default(false)
  cashEnabled            Boolean @default(false)
  pickupEnabled          Boolean @default(false)
  deliveryEnabled        Boolean @default(false)
  dineInEnabled          Boolean @default(true)
  stripeEnabled          Boolean @default(false)
  payInStoreEnabled      Boolean @default(true)
  cashOnCollectionEnabled Boolean @default(false)
  cashOnDeliveryEnabled  Boolean @default(false)
  deliveryRadiusMiles    Float   @default(5)
  deliveryFeePerMilePence Int     @default(0)
  originPostcode         String?
  prepTimeMinutes        Int     @default(15)
  vatRate                Float   @default(0.2)
  minimumOrderPence      Int     @default(1200)
  appStoreUrl            String?
  playStoreUrl           String?
  instagramUrl           String?
  tiktokUrl              String?
  updatedAt              DateTime @updatedAt
}

model LegalPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  lastUpdated String
  sections    Json
  published   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model CookieConsent {
  id         String   @id @default(cuid())
  sessionId  String?
  essential  Boolean  @default(true)
  analytics  Boolean  @default(false)
  functional Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([sessionId])
}
