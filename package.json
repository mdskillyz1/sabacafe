{
  "name": "saba-cafe-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Saba Cafe web platform with customer website, admin dashboard, shared API, Prisma schema, Stripe checkout, reviews, bookings, and ordering.",
  "scripts": {
    "dev": "pnpm --filter @saba/web dev:wasm",
    "dev:web": "pnpm --filter @saba/web dev:wasm",
    "build:web": "pnpm --filter @saba/web build:wasm",
    "postinstall": "pnpm --filter @saba/database prisma:generate",
    "db:generate": "pnpm --filter @saba/database prisma:generate",
    "db:push": "pnpm --filter @saba/database prisma:push",
    "db:migrate": "pnpm --filter @saba/database prisma:migrate",
    "db:seed": "pnpm --filter @saba/database seed",
    "lint": "pnpm --filter @saba/web lint",
    "typecheck": "pnpm --filter @saba/shared typecheck && pnpm --filter @saba/database typecheck && pnpm --filter @saba/web typecheck"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
